# Keep secrets, local state and dependencies out of every image build (build context = repo root).
.git
.github
**/.env
**/.env.*
!**/.env.example
**/.venv
**/node_modules
**/.next
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.coverage
**/htmlcov
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/.DS_Store
docs
