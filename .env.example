# Copy to .env. Values below are DEVELOPMENT defaults only; never reuse in production.

POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev_password
POSTGRES_DB=monitor
DATABASE_URL=postgresql+psycopg://monitor:monitor_dev_password@postgres:5432/monitor
REDIS_URL=redis://redis:6379/0

# Set ENVIRONMENT=production for any real deployment: the app then refuses to start with the placeholder
# SECRET_KEY below (which is public, because it is in this repository).
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-not-a-secret-change-me-please
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false

# Encrypts monitor headers and webhook URLs in Postgres. Leave empty in development (a key is derived from
# SECRET_KEY); REQUIRED when ENVIRONMENT is anything else. Back it up: losing it makes stored secrets unreadable.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: ENCRYPTION_KEY=<new>,<old>, run `python -m app.rotate_keys`, then drop <old>.
ENCRYPTION_KEY=

# Production only (docker-compose.prod.yml): the public hostname Caddy serves over HTTPS. Point its DNS at the host
# and open ports 80 and 443; Caddy obtains the certificate itself.
DOMAIN=

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Used by the Next.js server to reach the API inside the compose network
INTERNAL_API_URL=http://backend:8000

# SSRF: hostnames that may resolve to private IPs (dev only: the demo service).
# Leave empty in production.
SSRF_ALLOWED_HOSTS=demo-service

# Email notifications (Mailpit catches mail in dev: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@apimonitor.local
SMTP_STARTTLS=false

# Rate limiting (requests per window per client)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

SEED_DEMO_DATA=true

# Dead-man's switch (optional): the scheduler pings this URL about once a minute while it is healthy. Create a check
# at Healthchecks.io, Cronitor, Better Stack, ... and paste its ping URL to be alerted if Pulse itself stops.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=60

# Set true only when every request reaches the API through a proxy that sets X-Forwarded-For
# (both compose files set it for the API; production routes all traffic through Caddy, which overwrites it)
TRUST_PROXY_HEADERS=false
